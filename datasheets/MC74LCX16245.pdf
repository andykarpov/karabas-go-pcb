         <pdf:Producer>Acrobat Distiller 9.0.0 (Windows)</pdf:Producer>
         <xmp:CreatorTool>BroadVision, Inc.</xmp:CreatorTool>
         <xmp:ModifyDate>2020-10-19T09:50:09+08:00</xmp:ModifyDate>
