  (footprint "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical" (layer "F.Cu")
    (tstamp 908c24bf-86bf-42f7-9994-5c1ecebaeac7)
    (at 45.847 45.72)
    (descr "Through hole straight pin header, 1x04, 2.54mm pitch, single row")
