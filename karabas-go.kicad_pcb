  (gr_text "5V GND GND X" (at 42.291 43.9166 -90) (layer "F.SilkS") (tstamp 1bc9a216-2f33-4222-91a9-a2218386d840)
    (effects (font (size 1 1) (thickness 0.15)) (justify left bottom))
